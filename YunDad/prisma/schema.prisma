// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户模型
// ============================================
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String?
  babyName       String?
  dueDate        DateTime?
  pregnancyWeek  Int      @default(1)
  level          Int      @default(1)
  points         Int      @default(0)
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联关系
  mealPlans      MealPlan[]
  checkIns       CheckIn[]
  favorites      Favorite[]
  babyBagItems   BabyBagItem[]
  fetalMovements FetalMovement[]
  prenatalVisits PrenatalVisit[]

  @@index([email])
  @@index([level])
}
  email          String   @unique
  password       String?  // 可选，支持游客模式
  babyName       String?  // 宝宝昵称
  dueDate        DateTime? // 预产期
  pregnancyWeek  Int      @default(1) // 当前孕周
  level          Int      @default(1) // 用户等级 1-6
  points         Int      @default(0) // 积分
  avatar         String?  // 头像URL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联关系
  mealPlans      MealPlan[]
  checkIns       CheckIn[]
  favorites      Favorite[]
  babyBagItems   BabyBagItem[]

  @@index([email])
  @@index([level])
}

// ============================================
// 食谱模型
// ============================================
model Recipe {
  id             String   @id @default(cuid())
  name           String
  description    String?
  image          String?  // 图片URL
  mealType       String   // 餐食类型：breakfast/lunch/dinner/snack_morning/snack_afternoon/snack_evening
  ingredients    String   // 食材列表，JSON字符串
  steps          String   // 做法步骤，JSON字符串
  videoUrl       String?  // 视频链接，可选
  nutrition      String?  // 营养成分，JSON字符串：热量、蛋白质、脂肪、碳水化合物、维生素等
  suitableWeeks  String?  // 适合孕周，如"1-12"表示孕早期
  tags           String?  // 标签，JSON字符串
  rating         Float    @default(0) // 评分
  isRecommended  Boolean  @default(false) // 是否推荐
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联关系
  mealPlans      MealPlan[]
  checkIns       CheckIn[]
  favorites      Favorite[]

  @@index([mealType])
  @@index([isRecommended])
  @@index([rating])
}

// ============================================
// 饮食计划模型
// ============================================
model MealPlan {
  id           String   @id @default(cuid())
  userId       String   // 关联用户
  recipeId     String   // 关联食谱
  mealType     String   // 餐食类型
  planDate     DateTime // 计划日期
  isCompleted  Boolean  @default(false) // 是否完成
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联关系
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([planDate])
  @@index([userId, planDate])
}

// ============================================
// 打卡记录模型
// ============================================
model CheckIn {
  id         String    @id @default(cuid())
  userId     String    // 关联用户
  mealType   String    // 餐食类型
  recipeId   String?   // 关联食谱，可选
  checkDate  DateTime  // 打卡日期
  checkTime  DateTime  // 打卡时间
  points     Int       @default(0) // 获得积分
  note       String?   // 备注，可选
  createdAt  DateTime  @default(now())

  // 关联关系
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recipeId])
  @@index([checkDate])
  @@index([userId, checkDate])
}

// ============================================
// 待产包分类模型
// ============================================
model BabyBagCategory {
  id          String        @id @default(cuid())
  name        String
  icon        String?       // 图标
  sortOrder   Int           @default(0) // 排序
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // 关联关系
  items       BabyBagItem[]

  @@index([sortOrder])
}

// ============================================
// 待产包物品模型
// ============================================
model BabyBagItem {
  id           String            @id @default(cuid())
  categoryId   String            // 关联分类
  name         String            // 物品名称
  description  String?           // 说明，可选
  isDefault    Boolean           @default(false) // 是否系统默认
  isPrepared   Boolean           @default(false) // 是否已准备
  userId       String?           // 如果为null则表示系统默认物品
  sortOrder    Int               @default(0) // 排序
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // 关联关系
  category     BabyBagCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId])
  @@index([isDefault])
  @@index([sortOrder])
}

// ============================================
// 知识文章模型
// ============================================
model Knowledge {
  id            String   @id @default(cuid())
  title         String
  content       String   // 文章内容
  category      String   // 分类：taboo/knowledge/nutrition/faq
  tags          String?  // 标签，JSON字符串
  suitableWeeks String?  // 适合孕周
  viewCount     Int      @default(0) // 浏览次数
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([viewCount])
}

// ============================================
// 收藏模型
// ============================================
model Favorite {
  id        String   @id @default(cuid())
  userId    String   // 关联用户
  recipeId  String   // 关联食谱
  createdAt DateTime @default(now())

  // 关联关系
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId]) // 一个用户对同一个食谱只能收藏一次
  @@index([userId])
  @@index([recipeId])
}

// ============================================
// 每日小贴士模型
// ============================================
model DailyTip {
  id        String   @id @default(cuid())
  content   String   // 小贴士内容
  weekRange String?  // 适合孕周范围，如"20-24"
  category  String?  // 分类
  createdAt DateTime @default(now())

  @@index([weekRange])
  @@index([category])
}
